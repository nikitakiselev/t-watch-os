YANDEX_API_KEY=replace-me
YANDEX_FOLDER_ID=replace-me
# LAN-адрес сервера, по которому ЧАСЫ скачают аудио (не localhost!):
PUBLIC_BASE_URL=http://192.168.0.5:8080
SESSION_TTL=86400
YANDEX_VOICE=alena
# Модель YandexGPT: yandexgpt (умнее) или yandexgpt-lite (дешевле/быстрее):
YANDEX_GPT_MODEL=yandexgpt
# Лимит длины ответа в токенах (стихи/истории требуют запаса):
MAX_TOKENS=600
# Защита публичного сервера (пусто = выключено, только для локальной разработки):
# API_KEY — общий ключ для POST /talk (его шлют часы в заголовке X-API-Key и встраивает дебаг-страница).
API_KEY=replace-with-long-random-string
# WEB_PASSWORD — пароль на дебаг-страницу (Basic Auth, имя пользователя любое):
WEB_PASSWORD=replace-with-admin-password
