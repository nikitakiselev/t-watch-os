YANDEX_API_KEY=replace-me
YANDEX_FOLDER_ID=replace-me
# LAN-адрес сервера, по которому ЧАСЫ скачают аудио (не localhost!):
PUBLIC_BASE_URL=http://192.168.0.5:8080
SESSION_TTL=86400
YANDEX_VOICE=alena
# Модель YandexGPT: yandexgpt (умнее) или yandexgpt-lite (дешевле/быстрее):
YANDEX_GPT_MODEL=yandexgpt
# Лимит длины ответа в токенах (стихи/истории требуют запаса):
MAX_TOKENS=600
